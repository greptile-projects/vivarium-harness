# === arms ===

# Two plain HTTPS remotes. arm-run.sh clones each one into its arm's private
# /workspace using that arm's GH_TOKEN; never put a token in the URL.
KOMODO_REPO=https://github.com/your-org/vivarium-komodo.git
TUATARA_REPO=https://github.com/your-org/vivarium-tuatara.git

# Stable name prefixes for fresh per-subticket containers. runHarness creates
# and destroys the actual containers, volumes, and networks. Unset both only
# for a throwaway host smoke test.
KOMODO_CONTAINER=vivarium-komodo
TUATARA_CONTAINER=vivarium-tuatara

# Each arm's GitHub identity when it opens PRs.
KOMODO_GH_TOKEN=ghp_...
TUATARA_GH_TOKEN=ghp_...

# Unset: containers get danger-full-access, host arms workspace-write.
# CODEX_SANDBOX=danger-full-access

# Run Greg and both arms on Codex's fast service tier. Default false. Fast mode
# only applies to supported models and consumes ChatGPT credits faster.
# CODEX_FAST_MODE=false

# Where codex sessions live. Default ~/.codex.
# CODEX_HOME=/absolute/path/to/.codex

# Abort an arm after this much event silence. Default 240000; 0 disables.
# IDLE_TIMEOUT_MS=240000

# === review ===
# The one asymmetry in the experiment: exactly one arm answers this reviewer.

# Max review -> answer -> re-review rounds per pull request. Default 5. A
# maximum, not a count: the loop stops at the first round the reviewer adds
# nothing new, so a pull request that settles early costs one round.
# REVIEW_ROUNDS=5

# How long the landing phase waits for the reviewer before merging unreviewed,
# and how often it looks. Defaults 1200000 (20m) / 30000. The window rolls from
# the reviewer's last comment — "silent this long", not a per-round allowance —
# and the full window is only ever paid for a reviewer that never shows: an
# answer that leaves nothing on the pull request settles the exchange
# immediately. Keep REVIEW_TIMEOUT_MS in step with POLL_TIMEOUT in
# scripts/mirror_sync.sh, or the two arms' reviews are collected on different
# deadlines.
# REVIEW_TIMEOUT_MS=1200000
# REVIEW_POLL_MS=30000
# Reviewer activity is also batched until one fixed 30-second quiet interval
# passes, preventing one submitted review from creating several Codex turns.
