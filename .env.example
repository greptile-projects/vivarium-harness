# Static arm configuration. The orchestrator never changes these per ticket.
CONTROL_REPO=/absolute/path/to/control-checkout
GREPTILE_REPO=/absolute/path/to/greptile-checkout

# Use danger-full-access only inside the disposable Linux VMs described by the
# experiment. Local development defaults to workspace-write when this is unset.
# CODEX_SANDBOX=danger-full-access

# Durable run artifacts and copied Codex transcripts.
# RESULTS_DIR=results
# CODEX_HOME=/absolute/path/to/.codex

# Autonomous attempts per arm, including the initial attempt.
# MAX_ATTEMPTS=3

# Greg Tile — the stateless planner loop (bun run greg). All of these are
# optional; flags override them. The North Star and ladder are the only state
# Greg carries between rungs. A Linear MCP configured in your Codex environment
# lets Greg file a ticket per rung.
# GREG_NORTH_STAR=Build a working clone of GitHub
# GREG_LADDER=/absolute/path/to/LADDER.md
# GREG_MAX_RUNGS=10
# GREG_SANDBOX=read-only
